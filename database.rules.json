{
  "rules": {
    "games": {
      "$gameId": {
        "messages": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$msgId": {
            ".validate": "newData.hasChildren(['id', 'sender', 'text', 'timestamp', 'channel'])",
            "id": { ".validate": "newData.isString()" },
            "sender": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "channel": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "$other": { ".validate": false }
          }
        },

        "userDevices": {
          "$userId": {
            "$deviceId": {
              ".read": "auth != null && (auth.uid === $userId || root.child('games').child($gameId).child('presence').child(auth.uid).exists())",
              ".write": "auth != null && auth.uid === $userId",
              ".validate": "newData.hasChildren(['deviceId', 'deviceName'])",
              "deviceId": { ".validate": "newData.isString()" },
              "deviceName": { ".validate": "newData.isString()" },
              "lastActive": { ".validate": "newData.isNumber() || newData.val() === null" },
              "browser": { ".validate": "newData.isString()" },
              "os": { ".validate": "newData.isString()" }
            }
          }
        },

        "presence": {
          ".read": "auth != null",
          "$userId": {
            ".write": "auth != null && auth.uid === $userId",
            ".validate": "newData.hasChildren(['username', 'lastSeen'])",
            "username": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "at": { ".validate": "newData.isNumber()" },
            "deviceId": { ".validate": "newData.isString() || !newData.exists()" },
            "online": { ".validate": "newData.isBoolean() || !newData.exists()" }
          }
        },

        "realtime": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isObject()"
        },

        "heartbeat": {
          ".read": "auth != null",
          "$userId": {
            ".write": "auth != null && auth.uid === $userId",
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}
